flowchart LR
    act["Действие человека<br/>и команда к серверу"] --> base[("Одна транзакция:<br/>запись и очередь")]
    base --> ready{"Связь есть?"}
    ready -- "нет" --> wait["Ждём связи:<br/>человек работает дальше"]
    ready -- "да" --> build["Сборка запроса<br/>по свежему состоянию"]
    build --> send["Отправка<br/>замороженного запроса"]

    send --> ok["Принято: ответ записан,<br/>затем применён"]
    send --> lost["Ответ потерян:<br/>повтор тем же запросом"]
    send --> stale["412: версия устарела:<br/>перечитать и собрать заново"]

    classDef human fill:#DFC7F2,stroke:#102D69,stroke-width:2px,color:#102D69
