flowchart LR
    subgraph people["Люди"]
        me["Человек"]
        fam["Семья, соседи"]
        doc["Врач<br/>(вне системы)"]
    end
    subgraph places["Места хранения"]
        home["Дом"]
        dacha["Дача · общая"]
    end
    pkg["Упаковка<br/>остаток и срок годности<br/>новая покупка — новая упаковка"]
    subgraph cure["Лечение"]
        rx["Назначение<br/>доза, дни, время,<br/>число приёмов"]
        take["Приём<br/>доза из одной пачки"]
    end
    subgraph ext["Сведения извне"]
        crpt["Маркировка<br/>«Честный знак»"]
        vid["Справочник<br/>препаратов"]
    end
    doc -. назначает .-> rx
    me --> home
    fam --> dacha
    me --> dacha
    home --> pkg
    dacha --> pkg
    rx --> take
    take -- списывает --> pkg
    crpt -. что за упаковка .-> pkg
    vid -. название, форма .-> pkg
