classDiagram
    direction LR
    class Аптечка {
        название и место
        общая: да / нет
    }
    class Лекарство {
        название, форма
        остаток и единица
        срок годности
        версия
    }
    class Course["Курс лечения"] {
        доза, дни, время
        назначено доз
    }
    class Источник {
        место в порядке
        выделено доз
    }
    class Бронь {
        участник
        ещё не принятая часть
    }
    class Приём {
        по курсу или разовый
        принят / пропущен
        сколько списано
    }
    Аптечка "1" o-- "*" Лекарство : лежит
    Course "1" *-- "*" Источник : берёт дозы по порядку
    Источник "*" --> "1" Лекарство : из
    Источник .. Бронь : в общей аптечке бронь = невыбранное выделение
    Лекарство "1" *-- "*" Бронь : участников
    Course "0..1" o-- "*" Приём : назначает
    Приём "*" --> "0..1" Лекарство : списывает из одного
