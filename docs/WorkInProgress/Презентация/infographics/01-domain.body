classDiagram
    direction LR
    class Аптечка {
        название
        место хранения
        общая: да / нет
    }
    class Упаковка {
        название, форма
        остаток и единица
        срок годности
        версия
    }
    class Бронь {
        участник
        количество
    }
    class Course["Курс лечения"] {
        доза и форма
        дни недели и время
        число доз
    }
    class Источник {
        порядок расходования
        выделено доз
    }
    class Приём {
        по плану курса или однократно
        принят / пропущен
        сколько и из чего списано
    }
    Аптечка "1" o-- "*" Упаковка : лежит
    Упаковка "1" *-- "*" Бронь : в общей аптечке
    Course "1" *-- "*" Источник : обеспечен
    Источник "*" --> "1" Упаковка : берёт дозы из
    Course "0..1" o-- "*" Приём : назначает
    Приём "*" --> "0..1" Упаковка : списывает из одной
