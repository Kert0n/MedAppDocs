classDiagram
    direction LR
    class Аптечка {
        название и место хранения
        местная или общая
    }
    class Упаковка {
        остаток в своей единице
        форма, срок годности
    }
    class ЗаписьУпаковки["Запись об упаковке"] {
        имя, единица, форма
        живёт после конца пачки
    }
    class Курс["Курс лечения"] {
        назначение: доза, форма,
        расписание, число приёмов
    }
    class Источник {
        место в порядке
        выделено целых доз
    }
    class Приём {
        по курсу или разовый
        принят / пропущен
    }
    class Бронь {
        невыбранное выделение
        источника на общей упаковке
    }
    Аптечка "1" o-- "*" Упаковка : лежит
    Упаковка "1" --> "1" ЗаписьУпаковки : запись
    Курс "1" *-- "*" Источник : берёт дозы по порядку
    Источник "*" --> "1" Упаковка : из
    Источник "1" .. "0..1" Бронь : в общей аптечке
    Курс "0..1" o-- "*" Приём : назначает
    Приём "*" --> "1" ЗаписьУпаковки : доза из одной пачки
