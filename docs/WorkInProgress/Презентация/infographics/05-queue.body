stateDiagram-v2
    direction LR
    state "Ожидает" as wait
    state "Подготовка по свежему состоянию" as prep
    state "Отправка" as send
    state "Ответ записан" as ans
    state "Применена" as ok
    state "Отказ" as no
    state "Доступ утрачен" as lost
    [*] --> wait : изменение и команда<br/>одной транзакцией
    wait --> prep
    prep --> ok : на сервере уже так<br/>(без сервера)
    prep --> no : состояние негодно<br/>(без сервера)
    prep --> send : запрос собран<br/>и заморожен
    send --> wait : ответа нет:<br/>повтор тем же запросом
    send --> ans : ответ получен
    ans --> ok : 200
    ans --> wait : 412: собрать заново
    ans --> no : отказ сервера
    ans --> lost : аптечки больше нет
    ok --> [*]
    no --> [*]
    lost --> [*]
