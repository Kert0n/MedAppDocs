flowchart LR
    classDef req fill:#DFC7F2,stroke:#102D69,color:#102D69
    classDef lim fill:#FFFFFF,stroke:#102D69,color:#102D69
    classDef met fill:#102D69,stroke:#102D69,color:#FFFFFF
    r1["Работа без сети"]:::req --> l1["Сервер не может быть<br/>основным хранилищем"]:::lim --> m1["Местная база: основное хранилище,<br/>изменения к серверу через очередь"]:::met
    r2["Нет персональных данных"]:::req --> l2["Журнал приёмов<br/>не покидает устройство"]:::lim --> m2["Сервер получает суммы, а не события:<br/>одна синхронизация на упаковку"]:::met
    r3["Нет личности у пользователя"]:::req --> l3["Отдельную проверку права<br/>делать не по чему"]:::lim --> m3["Доступ: предикатом<br/>внутри самого запроса"]:::met
    r4["Общий остаток<br/>у нескольких людей"]:::req --> l4["Одну упаковку меняют<br/>одновременно"]:::lim --> m4["Удержание корня аптечки +<br/>предикат версии в UPDATE"]:::met
    r5["Форма запроса:<br/>часть требований"]:::req --> l5["ORM прячет текст<br/>и число запросов"]:::lim --> m5["Явный SQL через Exposed"]:::met
