flowchart LR
    start(["Первый запуск"]) --> acc["Учётная запись устройства<br/>создаётся сама:<br/>идентификатор + ключ"]
    acc --> kits["Аптечки<br/>дом, дача, рюкзак"]
    subgraph stock["Учёт"]
        kits --> add{"Завести лекарство"}
        add -- "вручную" --> hint["Подсказка справочника<br/>по неточному названию"]
        add -- "сканером" --> crpt["Код маркировки →<br/>реестр «Честный знак»"]
        hint --> pkg["Лекарство:<br/>остаток, срок, место"]
        crpt --> pkg
    end
    subgraph treat["Лечение"]
        pkg --> course["Курс лечения:<br/>доза, расписание"]
        course --> src["Источники и порядок:<br/>сначала то, что истекает раньше"]
        src --> day["План дня"]
        day --> notif["Напоминание"]
        notif --> ans{"Ответ"}
        ans -- "принял" --> take["Доза списана<br/>из конкретного лекарства"]
        ans -- "пропустил" --> skip["Отмечено,<br/>остаток не меняется"]
    end
    subgraph share["Общая аптечка"]
        kits --> inv["Приглашение:<br/>QR или код"]
        inv --> join["Второй участник<br/>вступает"]
        join --> claim["Бронь под курс<br/>на общем лекарстве"]
    end
    take --> rep["Отчёты:<br/>сводка, расход до даты,<br/>истрачено"]
    claim -.-> course
