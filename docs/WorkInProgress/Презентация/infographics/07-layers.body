    subgraph s["Сервер: слои сверху вниз"]
        direction TB
        s1["контроллеры"] --> s2["прикладные сервисы"] --> s3["оркестраторы сценариев"] --> s4["сервисы агрегатов"] --> s5["хранилища · Exposed"]
        ctx["Контексты: Аптечка · Справочник · Журнал приёмов"]
    end
    chk["Границы проверяются автоматически: клиент по дереву исходников, сервер по байт-коду.<br/>Нарушение роняет сборку."]
